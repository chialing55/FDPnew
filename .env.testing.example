# Copy this file to .env.testing before running Feature tests.
#
# IMPORTANT: RefreshDatabase recreates tables. Every configured SQL database
# must be dedicated to tests and its name must contain "test" or "testing".
# Never reuse development or production database names here.

APP_ENV=testing

DB_CONNECTION=mysql
DB_DATABASE=laravel_testing

DB_CONNECTION_FIRST=mysql
DB_DATABASE_FIRST=fs_tree_testing

DB_CONNECTION_SECOND=mysql
DB_DATABASE_SECOND=fs_seeds_testing

DB_CONNECTION_THIRD=mysql
DB_DATABASE_THIRD=fs_seedling_testing

DB_CONNECTION_FORTH=mysql
DB_DATABASE_FORTH=plant_catalog_testing

DB_CONNECTION_FIFTH=mysql
DB_DATABASE_FIFTH=ss_plot_testing

DB_CONNECTION_SIXTH=mysql
DB_DATABASE_SIXTH=fs_herbarium_testing

DB_CONNECTION_WEB=mysql
DB_DATABASE_WEB=web_testing

DB_CONNECTION_FS_MORTALITY=mysql
DB_DATABASE_FS_MORTALITY=fs_mortality_testing

DB_CONNECTION_FS_GEO_TREE_SURVEY=mysql
DB_DATABASE_FS_GEO_TREE_SURVEY=fs_geo_tree_survey_testing

DB_CONNECTION_NJS_SEEDLING=mysql
DB_DATABASE_NJS_SEEDLING=njs_seedling_testing

DB_CONNECTION_PLANT_CATALOG=mysql
DB_DATABASE_PLANT_CATALOG=plant_catalog_testing
