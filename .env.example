APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

DB_CONNECTION_FS_MORTALITY=mysql
DB_HOST_FS_MORTALITY=127.0.0.1
DB_PORT_FS_MORTALITY=3306
DB_DATABASE_FS_MORTALITY=fs_mortality
DB_USERNAME_FS_MORTALITY=root
DB_PASSWORD_FS_MORTALITY=

DB_CONNECTION_FS_GEO_TREE_SURVEY=mysql
DB_HOST_FS_GEO_TREE_SURVEY=127.0.0.1
DB_PORT_FS_GEO_TREE_SURVEY=3306
DB_DATABASE_FS_GEO_TREE_SURVEY=fs_geo_tree_survey
DB_USERNAME_FS_GEO_TREE_SURVEY=root
DB_PASSWORD_FS_GEO_TREE_SURVEY=

DB_CONNECTION_NJS_SEEDLING=mysql
DB_HOST_NJS_SEEDLING=127.0.0.1
DB_PORT_NJS_SEEDLING=3306
DB_DATABASE_NJS_SEEDLING=njs_seedling
DB_USERNAME_NJS_SEEDLING=root
DB_PASSWORD_NJS_SEEDLING=

DB_CONNECTION_PLANT_CATALOG=mysql
